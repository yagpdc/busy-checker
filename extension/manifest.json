{
  "manifest_version": 3,
  "name": "Busy Checker",
  "version": "0.1.0",
  "description": "Sabe se alguém está disponível agora juntando presença no navegador + Google Agenda.",
  "key": "",
  "permissions": ["identity", "storage", "alarms"],
  "host_permissions": ["http://localhost:8787/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Busy Checker"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.google.com/*"],
      "js": ["chat-google.js"],
      "run_at": "document_idle"
    }
  ]
}
