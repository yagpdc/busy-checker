{
  "manifest_version": 3,
  "name": "Toki",
  "version": "0.3.0",
  "description": "時 — vê a agenda do seu time e agenda reuniões direto do Google Chat.",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "key": "",
  "permissions": ["identity", "storage", "alarms", "downloads"],
  "host_permissions": ["http://localhost:8787/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Toki",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.google.com/*"],
      "js": ["chat-google.js"],
      "run_at": "document_idle"
    }
  ]
}
