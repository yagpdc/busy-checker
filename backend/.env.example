# Postgres
DATABASE_URL=postgres://busy:busy@localhost:5432/busy_checker

# Google OAuth (Web application credentials)
# Authorized redirect URI must be: https://<EXTENSION_ID>.chromiumapp.org/
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://<EXTENSION_ID>.chromiumapp.org/

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Session JWT
SESSION_JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=8787
# Comma-separated origins allowed to call the API (the extension origin is chrome-extension://<id>)
CORS_ORIGINS=chrome-extension://<EXTENSION_ID>

# Optional: restrict logins to a single Workspace domain
ALLOWED_HD=yourcompany.com
